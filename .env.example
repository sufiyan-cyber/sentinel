# Sentinel-Z Arena - Environment Configuration Example
# Copy this file to `.env` for local runs, or set these in your deployment dashboard:
#     cp .env.example .env

# ==============================================================================
# 1. System Role & Architecture
# ==============================================================================
# Role: "victim" (runs agent, gateway defense, and UI) or "attacker" (exfiltration server only)
SENTINELZ_ROLE=victim

# Random seed for reproducibility across agent tasks and evaluations
SENTINELZ_SEED=0

# ==============================================================================
# 2. Target Agent LLM Backend
# ==============================================================================
# Supported backends:
#   - "gemini"   : Google Gemini API (free key; also drives the desktop browser)
#   - "nvidia"   : NVIDIA NIM cloud API (free key; the default model falls for injections)
#   - "ollama"   : Local or remote Ollama server (Llama 3.1 8B)
#   - "scripted" : Deterministic ground-truth simulation (no model, no network, runs offline)
#   - "auto"     : first of NVIDIA -> Ollama -> Gemini that actually answers, else scripted.
#                  With no keys at all this is the offline scripted agent. (default)
SENTINELZ_LLM_BACKEND=auto

# --- Google Gemini API ---
# Get a free API key at: https://aistudio.google.com/
GEMINI_API_KEY=
SENTINELZ_GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# --- NVIDIA NIM API ---
# Get a key at: https://build.nvidia.com/
NVIDIA_API_KEY=
SENTINELZ_NVIDIA_MODEL=nvidia/nemotron-3.5-bolt-e4b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Local / LAN Ollama ---
# Run: ollama run llama3.1:8b
# For a remote host on LAN, specify e.g.: http://192.168.1.50:11434
OLLAMA_BASE_URL=http://localhost:11434
SENTINELZ_OLLAMA_MODEL=llama3.1:8b
SENTINELZ_ATTACKER_MODEL=llama3.1:8b

# --- Sarvam AI Multilingual Voice (Optional) ---
# Get a key at: https://dashboard.sarvam.ai/
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_SPEAKER=shubh

# --- CALL-E Agentic Phone Calling (Optional) ---
# Get a key at: https://www.heycall-e.com/
CALLE_API_KEY=
# Default friend phone number in E.164 format when user says "call my friend" without stating digits
CALLE_DEFAULT_PHONE=
CALLE_BASE_URL=https://api.heycall-e.com
# 1 (default) = the call tool reports success but dials nobody. Set 0 to place real calls.
CALLE_DRY_RUN=1
# 1 = "ring" the owner when a session is revoked (still obeys CALLE_DRY_RUN).
SENTINELZ_ALERT_CALL=1

# ==============================================================================
# 2b. Live Demo: Agent Profile, Wallet, Payments
# ==============================================================================
# natural     = the model decides for itself whether to obey injected text
# susceptible = the model still writes every word, but an instruction planted in
#               untrusted content is followed. Always labelled on the dashboard.
SENTINELZ_AGENT_PROFILE=natural

# The agent's wallet (whole rupees) and the spend cap used when the user names no amount.
SENTINELZ_WALLET_INR=5000
SENTINELZ_DEFAULT_SPEND_CAP_INR=1000
# Headroom over a stated budget, percent ("around 500" allows up to 550).
SENTINELZ_MANDATE_TOLERANCE=10

# mock (default, offline), cashfree or razorpay. Test credentials only:
# Cashfree always calls sandbox.cashfree.com and refuses a production key;
# Razorpay refuses any key id that does not start with rzp_test_.
SENTINELZ_PAYMENTS=mock
# Cashfree dashboard -> switch to Test -> Developers -> API Keys
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ==============================================================================
# 3. Network & Host Configuration
# ==============================================================================
# Attacker exfiltration collection server (Role=attacker or Laptop B)
SENTINELZ_ATTACKER_HOST=127.0.0.1
SENTINELZ_ATTACKER_PORT=8899

# Arena split-screen dashboard server
SENTINELZ_UI_HOST=127.0.0.1
SENTINELZ_UI_PORT=8800

# Live assistant server bindings. Keep 127.0.0.1 locally; a container sets 0.0.0.0.
HOST=127.0.0.1
PORT=8801

# Headless mode: "true" for headless cloud servers without GUI (Render/Docker)
# Set to "false" to see the live autonomous Chrome browser on your desktop
HEADLESS=false

# ==============================================================================
# 4. Defense Gateway & Signal Thresholds
# ==============================================================================
# Hard latency budget for inline mediation (in milliseconds)
SENTINELZ_DECISION_BUDGET_MS=100
SENTINELZ_SIGNAL_BUDGET_MS=80

# Taint threshold: tool result scoring above this triggers taint propagation
SENTINELZ_TAINT_THRESHOLD=0.5

# Hazard threshold (used ONLY by the ablation baseline `decide_threshold`)
SENTINELZ_HAZARD_THRESHOLD=0.5

# Force deterministic lexical fallback even if torch/transformers are installed (0 or 1)
SENTINELZ_FORCE_LEXICAL=0
