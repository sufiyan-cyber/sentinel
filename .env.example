# Copy this file to `.env` and edit. `.env` is gitignored — never commit it.

# ---------------------------------------------------------------- role
# victim   = laptop A: agent + signals + models + UI
# attacker = laptop B: exfiltration server only
SENTINELZ_ROLE=victim

# ---------------------------------------------------------------- LLM
# Which backend drives the target agent.
#   auto      probe Ollama, then Gemini; fall back to `scripted` if unreachable  (default)
#   gemini    use Google Gemini API (requires GEMINI_API_KEY)
#   ollama    require Ollama; error out if unreachable
#   scripted  never touch the network — deterministic simulated agent
SENTINELZ_LLM_BACKEND=auto

# Gemini API (cloud, for lower-spec machines without local Ollama)
# Get a key from https://aistudio.google.com/
GEMINI_API_KEY=
SENTINELZ_GEMINI_MODEL=gemini-3.6-flash

# Ollama base URL. NEVER hardcode localhost anywhere in the code.
# If Ollama runs on a second machine, put that machine's LAN IP here.
OLLAMA_BASE_URL=http://localhost:11434
SENTINELZ_OLLAMA_MODEL=llama3.1:8b

# Model used by the adaptive attacker to rewrite injections.
# Falls back to a deterministic mutation ladder when no LLM is present.
SENTINELZ_ATTACKER_MODEL=llama3.1:8b

# ---------------------------------------------------------------- network
# Laptop B's LAN address. Use 127.0.0.1 for single-machine (`solo`) runs.
SENTINELZ_ATTACKER_HOST=127.0.0.1
SENTINELZ_ATTACKER_PORT=8899

# Arena UI
SENTINELZ_UI_HOST=127.0.0.1
SENTINELZ_UI_PORT=8800

# ---------------------------------------------------------------- misc
SENTINELZ_SEED=0
# Hard budget for the whole decision path, milliseconds. Exceeding it -> REVOKE.
SENTINELZ_DECISION_BUDGET_MS=100
