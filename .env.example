# Sentinel-Z Arena - Environment Configuration Example
# Copy this file to `.env` for local runs, or set these in your deployment dashboard:
#     cp .env.example .env

# ==============================================================================
# 1. System Role & Architecture
# ==============================================================================
# Role: "victim" (runs agent, gateway defense, and UI) or "attacker" (exfiltration server only)
SENTINELZ_ROLE=victim

# Random seed for reproducibility across agent tasks and evaluations
SENTINELZ_SEED=0

# ==============================================================================
# 2. Target Agent LLM Backend
# ==============================================================================
# Supported backends:
#   - "gemini"   : Google Gemini API (Recommended for free, fast, vision browsing)
#   - "nvidia"   : NVIDIA NIM cloud API (Meta Llama 3.2 11B Vision Instruct)
#   - "ollama"   : Local or remote Ollama server (Llama 3.1 8B)
#   - "scripted" : Deterministic ground-truth simulation (no model, no network, runs offline)
#   - "auto"     : Automatically probes NVIDIA -> Ollama -> Gemini -> falls back to scripted
SENTINELZ_LLM_BACKEND=gemini

# --- Google Gemini API ---
# Get a free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
SENTINELZ_GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# --- NVIDIA NIM API ---
# Get a key at: https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_api_key_here
SENTINELZ_NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Local / LAN Ollama ---
# Run: ollama run llama3.1:8b
# For a remote host on LAN, specify e.g.: http://192.168.1.50:11434
OLLAMA_BASE_URL=http://localhost:11434
SENTINELZ_OLLAMA_MODEL=llama3.1:8b
SENTINELZ_ATTACKER_MODEL=llama3.1:8b

# ==============================================================================
# 3. Network & Host Configuration
# ==============================================================================
# Attacker exfiltration collection server (Role=attacker or Laptop B)
SENTINELZ_ATTACKER_HOST=127.0.0.1
SENTINELZ_ATTACKER_PORT=8899

# Arena split-screen dashboard server
SENTINELZ_UI_HOST=127.0.0.1
SENTINELZ_UI_PORT=8800

# Live assistant server bindings
HOST=0.0.0.0
PORT=8801

# Headless mode: "true" for headless cloud servers without GUI (Render/Docker)
# Set to "false" to see the live autonomous Chrome browser on your desktop
HEADLESS=false

# ==============================================================================
# 4. Defense Gateway & Signal Thresholds
# ==============================================================================
# Hard latency budget for inline mediation (in milliseconds)
SENTINELZ_DECISION_BUDGET_MS=100
SENTINELZ_SIGNAL_BUDGET_MS=80

# Taint threshold: tool result scoring above this triggers taint propagation
SENTINELZ_TAINT_THRESHOLD=0.5

# Hazard threshold (used ONLY by the ablation baseline `decide_threshold`)
SENTINELZ_HAZARD_THRESHOLD=0.5

# Force deterministic lexical fallback even if torch/transformers are installed (0 or 1)
SENTINELZ_FORCE_LEXICAL=0
