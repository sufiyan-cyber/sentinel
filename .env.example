# Sentinel-Z Arena - Environment Configuration Example
# Copy this file to `.env` for local runs, or set these in your Render Environment Variables dashboard.

# Role
SENTINELZ_ROLE=victim

# LLM Backend: "gemini" or "nvidia" (cloud) or "ollama" (local)
SENTINELZ_LLM_BACKEND=gemini

# Google Gemini API (Recommended for free, fast, vision-capable browsing)
# Get a free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
SENTINELZ_GEMINI_MODEL=gemini-3.5-flash-lite

# NVIDIA NIM API (Alternative cloud model)
# Get a key at: https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_api_key_here
SENTINELZ_NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct

# Headless mode: "true" for cloud servers without a monitor (Render/Docker)
HEADLESS=true

# Host and Port bindings
HOST=0.0.0.0
PORT=8801
